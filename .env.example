# Public issuer identity. Must be the exact externally reachable API base.
PORTABLE_COLLECTION_ISSUER=https://cards.example.com/api

# PKCS#8 DER Ed25519 private key encoded as base64.
# Generate with the Node command documented in README.md and store it in a secret manager.
PORTABLE_COLLECTION_PRIVATE_KEY_BASE64=

# Source issuers this deployment accepts for imports.
# Empty by default.
PORTABLE_COLLECTION_TRUSTED_ISSUERS=

# Destination clients allowed to request live collection authorization.
# Empty by default.
PORTABLE_COLLECTION_TRUSTED_CLIENTS=

# Reference server only.
REDIS_URL=redis://redis:6379
PORT=3100
