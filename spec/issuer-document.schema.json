{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wikicard:schema:issuer-document:1.0.0",
  "title": "WikiCard Portable Collection Issuer Document v1",
  "type": "object",
  "required": [
    "issuer",
    "protocol",
    "version",
    "keys"
  ],
  "additionalProperties": true,
  "properties": {
    "issuer": {
      "type": "string",
      "format": "uri"
    },
    "protocol": {
      "const": "org.wikicard.collection"
    },
    "version": {
      "const": "1.0.0"
    },
    "keys": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "use",
          "alg",
          "kty",
          "crv",
          "x"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "use": {
            "const": "sig"
          },
          "alg": {
            "const": "EdDSA"
          },
          "kty": {
            "const": "OKP"
          },
          "crv": {
            "const": "Ed25519"
          },
          "x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": [
        "protocol",
        "authorizationEndpoint",
        "tokenEndpoint",
        "collectionEndpoint",
        "codeChallengeMethods"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "WIKICARD-AUTH-CODE-1"
        },
        "authorizationEndpoint": {
          "type": "string",
          "format": "uri"
        },
        "tokenEndpoint": {
          "type": "string",
          "format": "uri"
        },
        "collectionEndpoint": {
          "type": "string",
          "format": "uri"
        },
        "codeChallengeMethods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "S256"
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discord": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    }
  }
}
